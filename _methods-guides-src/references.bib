% Cited only in a commented-out passage of the unbiasedness guide, on Fisher's
% purple-flower example and conditioning on realized arm counts.
% CAVEAT, should that passage ever be restored: Little (1989) and Upton (1992) are
% squarely in the conditional-vs-unconditional debate for 2x2 tables, but in that debate
% the group sizes are the ROW margins, fixed by design under product-binomial sampling;
% the disputed quantity is the second (outcome) margin. The passage invokes them for
% conditioning on realized TREATMENT/CONTROL group sizes, which may be a subtly
% different proposition. Neither paper could be confirmed to contain Fisher's
% purple-flower example itself (full texts were not reachable). Check the full texts
% before restoring the passage.
@article{little1989,
  author    = {Little, Roderick J. A.},
  title     = {Testing the Equality of Two Independent Binomial Proportions},
  journal   = {The American Statistician},
  volume    = {43},
  number    = {4},
  pages     = {283--288},
  year      = {1989},
  doi       = {10.1080/00031305.1989.10475676}
}

% Brooks/Cole is the imprint; Cengage Learning is the parent company. Duxbury published
% the 1st edition (1999) and is wrong for the 2nd. ISBN 978-0-495-10527-5.
@book{lohr2010,
  author    = {Lohr, Sharon L.},
  title     = {Sampling: Design and Analysis},
  edition   = {2nd},
  publisher = {Brooks/Cole},
  address   = {Boston},
  year      = {2010}
}

% The published title of this discussion piece is simply "Comment" (Taylor & Francis and
% Crossref, DOI below); JSTOR indexes it as the parent symposium title with "Comment"
% appended. The descriptive title below is supplied so the entry is self-explanatory.
% Basu's title is brace-protected as a whole so that chicago.bst's sentence-casing does
% not lowercase a title being quoted.
@article{rubin1980b,
  author    = {Rubin, Donald B.},
  title     = {Comment on ``{Randomization Analysis of Experimental Data: The Fisher Randomization Test}'' by {D}. {Basu}},
  journal   = {Journal of the American Statistical Association},
  volume    = {75},
  number    = {371},
  pages     = {591--593},
  year      = {1980},
  doi       = {10.1080/01621459.1980.10477517}
}

% Comment on Holland, "Statistics and Causal Inference", JASA 81(396), 945--960.
% Crossref stores this as title "Comment" plus subtitle "Which Ifs Have Causal Answers";
% Taylor & Francis renders that as "Comment: Which Ifs Have Causal Answers". Unlike
% rubin1980b, this piece does have a distinctive published subtitle, so it needs no
% supplied title to be identifiable. The parent article is named below anyway, to match
% the treatment of rubin1980b: a discussion-piece entry should tell the reader what it
% discusses, and "Which Ifs Have Causal Answers" alone does not reveal Holland.
% Holland's title is brace-protected against sentence-casing, as is Basu's in rubin1980b.
@article{rubin1986,
  author    = {Rubin, Donald B.},
  title     = {Comment on ``{Statistics and Causal Inference}'' by {P}. {W}. {Holland}: Which Ifs Have Causal Answers},
  journal   = {Journal of the American Statistical Association},
  volume    = {81},
  number    = {396},
  pages     = {961--962},
  year      = {1986},
  doi       = {10.1080/01621459.1986.10478355}
}

% Cited only in a commented-out passage of the unbiasedness guide, alongside Little
% (1989); see the caveat on that entry. "Fisher" is brace-protected so it survives
% sentence-casing.
% Journal name: this journal has been re-platformed twice and has three competing
% published forms -- Crossref/JSTOR use "Journal of the Royal Statistical Society.
% Series A (Statistics in Society)"; Oxford Academic (current publisher) uses "Journal
% of the Royal Statistical Society Series A: Statistics in Society"; Wiley (former
% platform) used "Journal of the Royal Statistical Society: Series A (Statistics in
