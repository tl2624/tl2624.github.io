% Edition: a genuine publisher-vs-book conflict. The printed book names itself only in
% its table of contents, as "Foreword to the Revised Edition"; its title and copyright
% pages carry no edition statement at all. Cambridge University Press's own catalog
% titles the 2009 book "Statistical Models: Theory and Practice 2nd edition", and
% library MARC records follow CUP ("2nd ed."), recording the 2005 book as the 1st.
% "2nd" is used here to agree with the publisher and with library catalogs; "Revised"
% is defensible as the book's own self-description.
% Original edition 2005. ISBN 9780521743853 (pbk), 9780521112437 (hbk).
%
% Place: "New York" is used here by choice. Note for the record that the copyright page
% names Cambridge first, in the imprint line "Cambridge, New York, Melbourne, Madrid,
% Cape Town, Singapore, Sao Paulo, Delhi", with the New York office address
% ("32 Avenue of the Americas") below it. The Library of Congress record for LCCN
% 2009002062 carries two place subfields, "Cambridge ;" then "New York :" (AACR2 1.4C5:
% first-named place plus the place in the cataloging agency's own country), so New York
% is among the recorded places. Cambridge University Press's own RDA record gives
% "Cambridge" alone. "Cambridge" would be the first-named-place convention; "New York"
% agrees with the LC record's US place and with imbensrubin2015 below.
@book{freedman2009,
  author    = {Freedman, David A.},
  title     = {Statistical Models: Theory and Practice},
  edition   = {2nd},
  publisher = {Cambridge University Press},
  address   = {New York},
  year      = {2009}
}

% Norton's full imprint form is "W. W. Norton & Company"; the short form used here is
% the one the Library of Congress uses.
@book{gerbergreen2012,
  author    = {Gerber, Alan S. and Green, Donald P.},
  title     = {Field Experiments: Design, Analysis, and Interpretation},
  publisher = {W. W. Norton},
  address   = {New York},
  year      = {2012}
}

% Place: the printed copyright page gives only a New York address, and LC/Harvard record
