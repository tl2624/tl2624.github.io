% references.bib
% Bibliography for the design-based causal inference methods guides:
%   - Notation and Setup for Design-Based Causal Inference
%   - Unbiasedness of the Difference-in-Means Estimator for the SATE and the PATE
%   - Variance of the Difference-in-Means Estimator for the SATE and Estimation of That Variance
%   - Variance of the Difference-in-Means Estimator for the PATE and Estimation of That Variance
%
% Style: chicago (natbib). chicago.bst sentence-cases ARTICLE titles but leaves BOOK
% titles as given, so proper nouns in article titles are brace-protected to survive the
% case change. chicago.bst declares no doi/url/isbn fields and silently ignores them;
% the DOIs below are recorded for portability should the guides move to biblatex.
%
% Entries verified against publisher and library records, July 2026.

@book{cochran1977,
  author    = {Cochran, William G.},
  title     = {Sampling Techniques},
  edition   = {3rd},
  publisher = {John Wiley \& Sons},
  address   = {New York},
  year      = {1977}
}

